# Shopify Headless Configuration
# Copy this file to .env.local and fill in your values

# Shopify store domain (e.g., your-store-name - just the subdomain, not full URL)
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API access token (private token) - for webhooks and customer upsert
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Webhook secret for verifying Shopify webhooks (from Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Google OAuth for NextAuth.js (if using Google SSO)
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Redis for rate limiting/sessions (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Sentry for error monitoring
SENTRY_DSN=

# Optional: Analytics (RudderStack/Segment)
RUDDERSTACK_WRITE_KEY=
RUDDERSTACK_DATA_PLANE_URL=

# Feature flags
USE_SHOPIFY_PRODUCTS=true
USE_SHOPIFY_CART=true
USE_GOOGLE_SSO=true

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# 1. Set NEXTAUTH_URL to your production domain
# 2. Generate a secure NEXTAUTH_SECRET (openssl rand -base64 32)
# 3. Configure Google OAuth in Google Cloud Console:
#    - Add authorized redirect URI: https://yourdomain.com/api/auth/callback/google
# 4. Verify Shopify tokens have correct scopes:
#    - Storefront: unauthenticated_read_product_listings, unauthenticated_read_customers
#    - Admin: read_customers, write_customers, read_orders
