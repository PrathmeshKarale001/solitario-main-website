# Shopify Headless Configuration
# Copy this file to .env.local and fill in your values

# Shopify store domain (e.g., your-store-name - just the subdomain, not full URL)
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API access token (private token) - for webhooks and customer upsert
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Webhook secret for verifying Shopify webhooks (from Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs (update for production)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Redis for rate limiting/sessions (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Sentry for error monitoring
SENTRY_DSN=

# Optional: Analytics (RudderStack/Segment)
RUDDERSTACK_WRITE_KEY=
RUDDERSTACK_DATA_PLANE_URL=

# Feature flags
USE_SHOPIFY_PRODUCTS=true
USE_SHOPIFY_CART=true

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# 1. Create Clerk application at https://dashboard.clerk.com
# 2. Copy publishable key and secret key from Clerk dashboard
# 3. Update Clerk URLs for production domain
# 4. Verify Shopify tokens have correct scopes:
#    - Storefront: unauthenticated_read_product_listings, unauthenticated_read_customers
#    - Admin: read_customers, write_customers, read_orders
