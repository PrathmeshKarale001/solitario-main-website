# Solitario Website Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SHOPIFY CONFIGURATION
# ===========================================
SHOPIFY_STORE_DOMAIN=your-store-name
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get your API keys from: https://dashboard.razorpay.com/app/keys
# For testing: Use test keys (rzp_test_xxx)
# For production: Use live keys (rzp_live_xxx)

RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX

# Webhook Secret (optional - for webhook verification)
# Generate from: Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-a-random-secret-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# EMAIL (Resend)
# ===========================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXX

# ===========================================
# DELHIVERY SHIPPING
# ===========================================
# Get your API key from: https://developer.delhivery.com/
DELHIVERY_API_KEY=your_delhivery_api_key_here

# Warehouse/Pickup Location Details
DELHIVERY_WAREHOUSE_NAME=Solitario Warehouse
DELHIVERY_WAREHOUSE_ADDRESS=Your Warehouse Address
DELHIVERY_WAREHOUSE_CITY=Pune
DELHIVERY_WAREHOUSE_STATE=Maharashtra
DELHIVERY_WAREHOUSE_PIN=411001
DELHIVERY_WAREHOUSE_PHONE=9999999999

# ===========================================
# ANALYTICS & TRACKING
# ===========================================
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (Facebook Pixel)
# Get from: https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=33782623678050877

# ===========================================
# AI FEATURES (optional)
# ===========================================
GEMINI_API_KEY=
FREEPIK_API_KEY=

# ===========================================
# RADAR GEOFENCING & LOCATION SERVICES
# ===========================================
# Get your API keys from: https://dashboard.radar.com/settings
# Sign up at: https://radar.com/signup
# Account email: eodonsocial@gmail.com

# For Development/Testing - Use Test Publishable Key
NEXT_PUBLIC_RADAR_PUBLISHABLE_KEY=prj_test_pk_XXXXXXXXXXXXXXXXXXXXXXXXXX

# For Production - Use Live Publishable Key (add to .env.production)
# NEXT_PUBLIC_RADAR_PUBLISHABLE_KEY=prj_live_pk_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Note: Only use PUBLISHABLE keys on client-side
# Never use SECRET keys in NEXT_PUBLIC_ variables

# ===========================================
# PROMOTIONS & LOYALTY SYSTEM
# ===========================================
# Enable/disable the entire promotion system
PROMO_ENABLED=true

# First purchase discount (applied to Clerk users with 0 paid orders)
PROMO_FIRST_PURCHASE_PERCENT=20

# Loyalty coupon settings
PROMO_LOYALTY_PERCENT=10
PROMO_LOYALTY_VALIDITY_DAYS=30

# Cart-based discounts
PROMO_BUY2_PERCENT=10
PROMO_BUY3_PERCENT=30

# Gift product for Buy 2 promotion
# Get variant ID from Shopify Admin or GraphQL API
PROMO_GIFT_VARIANT_ID=gid://shopify/ProductVariant/YOUR_VARIANT_ID
PROMO_GIFT_PRODUCT_NAME=10-cent Diamond Gift

# Allow first purchase discount to stack with cart rules (not recommended)
PROMO_STACKING_FIRST_PURCHASE=false

# ===========================================
# FEATURE FLAGS
# ===========================================# Feature flags
USE_SHOPIFY_PRODUCTS=true
USE_SHOPIFY_CART=true
USE_GOOGLE_SSO=false

# Feature Toggle Flags
# Set to 'true' to enable collectibles feature (Warner Bros collection)
NEXT_PUBLIC_FEATURE_COLLECTIBLES_ENABLED=false

# Set to 'false' to disable Radar geofencing
NEXT_PUBLIC_FEATURE_RADAR_GEOFENCING_ENABLED=true

# Set to 'true' to enable MCP (Model Context Protocol) AI search feature
# Disabled by default for production
NEXT_PUBLIC_FEATURE_MCP_ENABLED=false
