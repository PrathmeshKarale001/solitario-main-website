# Solitario Website Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SHOPIFY CONFIGURATION
# ===========================================
SHOPIFY_STORE_DOMAIN=your-store-name
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get your API keys from: https://dashboard.razorpay.com/app/keys
# For testing: Use test keys (rzp_test_xxx)
# For production: Use live keys (rzp_live_xxx)

RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX

# Webhook Secret (optional - for webhook verification)
# Generate from: Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-a-random-secret-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# EMAIL (Resend)
# ===========================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXX

# ===========================================
# DELHIVERY SHIPPING
# ===========================================
# Get your API key from: https://developer.delhivery.com/
DELHIVERY_API_KEY=your_delhivery_api_key_here

# Warehouse/Pickup Location Details
DELHIVERY_WAREHOUSE_NAME=Solitario Warehouse
DELHIVERY_WAREHOUSE_ADDRESS=Your Warehouse Address
DELHIVERY_WAREHOUSE_CITY=Pune
DELHIVERY_WAREHOUSE_STATE=Maharashtra
DELHIVERY_WAREHOUSE_PIN=411001
DELHIVERY_WAREHOUSE_PHONE=9999999999

# ===========================================
# AI FEATURES (optional)
# ===========================================
GEMINI_API_KEY=
FREEPIK_API_KEY=

# ===========================================
# FEATURE FLAGS
# ===========================================
USE_SHOPIFY_PRODUCTS=true
USE_SHOPIFY_CART=true
USE_GOOGLE_SSO=false
